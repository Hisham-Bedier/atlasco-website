<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlasco_page_hero_list" model="ir.ui.view">
        <field name="name">atlasco.page.hero.list</field>
        <field name="model">atlasco.page.hero</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="label"/>
                <field name="section" optional="hide"/>
                <field name="image" widget="image" options="{'size': [64, 64]}"/>
            </tree>
        </field>
    </record>

    <record id="view_atlasco_page_hero_form" model="ir.ui.view">
        <field name="name">atlasco.page.hero.form</field>
        <field name="model">atlasco.page.hero</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="label" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="section"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_atlasco_page_hero_search" model="ir.ui.view">
        <field name="name">atlasco.page.hero.search</field>
        <field name="model">atlasco.page.hero</field>
        <field name="arch" type="xml">
            <search>
                <field name="label"/>
                <filter string="Site Pages" name="filter_site_page" domain="[('section', '=', 'site_page')]"/>
                <filter string="Industries" name="filter_industry" domain="[('section', '=', 'industry')]"/>
                <filter string="Services" name="filter_service" domain="[('section', '=', 'service')]"/>
                <filter string="Partners" name="filter_partner" domain="[('section', '=', 'partner')]"/>
                <filter string="Product Categories" name="filter_product_category" domain="[('section', '=', 'product_category')]"/>
                <filter string="Products" name="filter_product" domain="[('section', '=', 'product')]"/>
                <group expand="1" string="Group By">
                    <filter string="Section" name="group_by_section" context="{'group_by': 'section'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_atlasco_page_hero" model="ir.actions.act_window">
        <field name="name">Page Hero Banners</field>
        <field name="res_model">atlasco.page.hero</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_section': 1}</field>
        <field name="help" type="html">
            <p>One row per page on the site — the single place to replace any hero banner photo. Click a row's image to upload a replacement; leave empty to keep the current photo. Grouped by Section (Site Pages, Industries, Services, Partners, Product Categories, Products) — use the filters to narrow down, or search by name.</p>
        </field>
    </record>

    <menuitem id="menu_atlasco_page_hero"
              name="Page Hero Banners"
              parent="atlasco_website.menu_atlasco_group_media"
              action="action_atlasco_page_hero"
              sequence="20"/>

    <!-- Idempotent seed of the page-hero rows (runs on install + upgrade) -->
    <function model="atlasco.page.hero" name="_seed_pages"/>
</odoo>
