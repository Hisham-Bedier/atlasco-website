<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="product_l2" name="Products L2 — Sub-categories">
<t t-call="atlasco_website.atlasco_layout">

<!-- HERO (Figma 4838:274) — unchanged banner -->
<t t-set="hero_bg" t-value="request.env['atlasco.page.hero'].sudo()._image_url('product_category_' + category.get('slug', '')) or category.get('banner')"/>
<!-- Namespaced per-category oe_structure (same pattern as industry_detail.xml):
     this template is shared across every /products/<category> page, so a
     plain id="wrap" would make a block inserted while editing one category
     appear on every other category sharing this template. -->
<div t-attf-id="wrap_product_category_#{category.get('slug', '')}" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.product_l2').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]">

<!-- Genuinely-empty "gap" oe_structure divs threaded between the sections
     below are real Odoo-native Insert-Blocks drop targets - see the long
     root-cause comment on wrap_about in atlasco_about_page.xml. Namespaced
     per-category like the div above, for the same COW-safety reason. -->
<div t-attf-id="wrap_product_category_#{category.get('slug', '')}_gap_0" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.product_l2').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[1]"/>

<section class="atl-products-l2-hero" t-att-style="hero_bg and ('background-image:linear-gradient(rgba(27,38,44,.12),rgba(27,38,44,.15)),url(' + hero_bg + ');background-size:cover;background-position:center;') or ''">
    <div class="atl-products-l2-hero-inner">
        <h1><t t-esc="category['name']"/></h1>
        <p><t t-esc="category['intro']"/></p>
        <div class="atl-products-l2-hero-actions">
            <a href="/contact" class="atl-products-l2-btn-primary">Request a Consultation &#8594;</a>
            <a href="/contact" class="atl-products-l2-btn-outline">Download Capabilities</a>
        </div>
    </div>
</section>

<!-- ===== L2 REDESIGN (12-7 Gas Generation handoff) ===== -->
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&amp;family=IBM+Plex+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<style>
  .p2x-wrap{font-family:'IBM Plex Sans',system-ui,sans-serif}
  .p2x-wrap h2,.p2x-wrap h3,.p2x-wrap h4{font-family:'Oswald',sans-serif}
  .p2x-subcats{background:#F3F4F5;padding:clamp(48px,7vw,88px) clamp(18px,4vw,56px)}
  .p2x-inner{max-width:var(--atl-content-max-width);margin:0 auto}
  .p2x-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:44px;flex-wrap:wrap}
  .p2x-eyebrow{font-size:12px;font-weight:700;letter-spacing:2px;color:#1B7A3D;text-transform:uppercase}
  .p2x-head h2{font-weight:700;font-size:clamp(30px,4.4vw,44px);letter-spacing:.5px;color:#141a1c;margin:10px 0 0}
  .p2x-head-intro{max-width:360px;font-size:14.5px;line-height:1.6;color:#6b7175;margin:0}
  .p2x-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px}
  .p2x-card{position:relative;border-radius:18px;overflow:hidden;background:#dfe3e4;min-height:300px;display:block;box-shadow:0 12px 30px rgba(15,20,20,.12);transition:box-shadow .3s,transform .3s}
  .p2x-card:hover{box-shadow:0 22px 46px rgba(15,20,20,.22);transform:translateY(-4px)}
  .p2x-card-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s}
  .p2x-card:hover .p2x-card-img{transform:scale(1.06)}
  .p2x-card-fallback{position:absolute;inset:0;background:linear-gradient(135deg,#2a3a30,#0F1314)}
  .p2x-card-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,16,12,.12) 28%,rgba(9,16,12,.9) 100%);pointer-events:none}
  .p2x-badge{position:absolute;top:18px;left:18px;background:rgba(27,122,61,.95);color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:14px;width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;z-index:2}
  .p2x-card-body{position:absolute;left:26px;right:26px;bottom:24px;z-index:2;pointer-events:none}
  .p2x-card-body h3{font-weight:700;font-size:22px;line-height:1.08;color:#fff;margin:0}
  .p2x-card-body p{font-size:14px;line-height:1.55;color:rgba(255,255,255,.85);margin:10px 0 0}
  .p2x-card-link{display:inline-flex;align-items:center;gap:7px;margin-top:14px;font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:#8fe0aa;transition:gap .3s}
  .p2x-card:hover .p2x-card-link{gap:12px}
  .p2x-process{background:#0F1314;padding:clamp(48px,7vw,88px) clamp(18px,4vw,56px)}
  .p2x-process-head{text-align:center;margin-bottom:60px}
  .p2x-process-head h2{font-weight:700;font-size:clamp(28px,4vw,40px);letter-spacing:.5px;color:#fff;margin:0}
  .p2x-process-rule{width:64px;height:4px;background:#1B7A3D;margin:20px auto 0;border-radius:2px}
  .p2x-steps{display:grid;grid-template-columns:repeat(4,1fr);max-width:var(--atl-content-max-width);margin:0 auto}
  .p2x-step{padding:0 26px;border-right:1px solid rgba(255,255,255,.1)}
  .p2x-step:last-child{border-right:none}
  .p2x-step-num{font-family:'Oswald',sans-serif;font-weight:700;font-size:58px;line-height:1;color:#1B7A3D}
  .p2x-step h4{font-size:20px;font-weight:700;color:#fff;margin:18px 0 0}
  .p2x-step p{font-size:14px;line-height:1.65;color:#9aa0a2;margin:12px 0 0}
  .p2x-cta{background:linear-gradient(120deg,#1C7A3D 0%,#12622F 100%)}
  .p2x-cta-in{max-width:var(--atl-content-max-width);margin:0 auto;padding:clamp(48px,6vw,72px) clamp(18px,4vw,24px);display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap}
  .p2x-cta-copy{max-width:640px}
  .p2x-cta-copy h2{font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(30px,4.6vw,46px);line-height:1.02;color:#fff;margin:0 0 16px}
  .p2x-cta-copy p{font-size:18px;line-height:1.6;color:rgba(255,255,255,.9);margin:0}
  .p2x-cta-btn{flex:none;background:#fff;color:#12622F;font-weight:700;font-size:15px;letter-spacing:.5px;padding:19px 34px;border-radius:8px;text-transform:uppercase}
  @media(max-width:820px){.p2x-steps{grid-template-columns:1fr 1fr;gap:40px 0}.p2x-step{padding:0 20px}.p2x-step:nth-child(2){border-right:none}}
  @media(max-width:520px){.p2x-steps{grid-template-columns:1fr}.p2x-step{border-right:none;border-bottom:1px solid rgba(255,255,255,.1);padding-bottom:24px;margin-bottom:24px}.p2x-step:last-child{border-bottom:none;margin-bottom:0}}
</style>

  <div t-attf-id="wrap_product_category_#{category.get('slug', '')}_gap_1" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.product_l2').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[2]"/>

  <!-- SUB-CATEGORY GRID -->
  <section class="p2x-subcats p2x-wrap">
    <div class="p2x-inner">
      <div class="p2x-head">
        <div>
          <div class="p2x-eyebrow"><t t-esc="category['name']"/></div>
          <h2>OUR SUB-CATEGORIES</h2>
        </div>
        <p class="p2x-head-intro"><t t-esc="category.get('tagline') or category.get('intro')"/></p>
      </div>
      <div class="p2x-grid">
        <t t-foreach="category['items']" t-as="item">
          <a t-att-href="'/products/' + category['slug'] + '/' + item['slug']" class="p2x-card">
            <t t-if="item.get('image')">
              <img class="p2x-card-img" t-att-src="item['image']" t-att-alt="item['name']" loading="lazy"/>
            </t>
            <t t-else="">
              <div class="p2x-card-fallback"></div>
            </t>
            <div class="p2x-card-shade"></div>
            <div class="p2x-badge"><t t-esc="'%02d' % (item_index + 1)"/></div>
            <div class="p2x-card-body">
              <h3><t t-esc="item['name']"/></h3>
              <p><t t-esc="item.get('tagline')"/></p>
              <span class="p2x-card-link">Learn More <span>&#8594;</span></span>
            </div>
          </a>
        </t>
      </div>
    </div>
  </section>

  <div t-attf-id="wrap_product_category_#{category.get('slug', '')}_gap_2" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.product_l2').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[3]"/>

  <!-- HOW WE SPECIFY YOUR SYSTEM -->
  <section class="p2x-process p2x-wrap">
    <div class="p2x-process-head">
      <h2>HOW WE SPECIFY YOUR SYSTEM</h2>
      <div class="p2x-process-rule"></div>
    </div>
    <div class="p2x-steps">
      <div class="p2x-step">
        <div class="p2x-step-num">01</div>
        <h4>Consult</h4>
        <p>Survey site conditions, demand profile and duty cycle on day one.</p>
      </div>
      <div class="p2x-step">
        <div class="p2x-step-num">02</div>
        <h4>Specify</h4>
        <p>Engineers select the right model, size, controls and accessories.</p>
      </div>
      <div class="p2x-step">
        <div class="p2x-step-num">03</div>
        <h4>Install</h4>
        <p>Turnkey installation, commissioning and energy-baseline measurement.</p>
      </div>
      <div class="p2x-step">
        <div class="p2x-step-num">04</div>
        <h4>Service</h4>
        <p>OEM spares, scheduled maintenance and 24/7 reliability support.</p>
      </div>
    </div>
  </section>

  <div t-attf-id="wrap_product_category_#{category.get('slug', '')}_gap_3" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.product_l2').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[4]"/>

  <!-- LARGE CTA -->
  <section class="p2x-cta p2x-wrap">
    <div class="p2x-cta-in">
      <div class="p2x-cta-copy">
        <h2>Need the right <t t-esc="category['name']"/> for your operation?</h2>
        <p>Talk to an Atlasco specialist &#8212; we match the spec to your site, not the other way around.</p>
      </div>
      <a href="/contact" class="p2x-cta-btn">Talk to a Specialist</a>
    </div>
  </section>

  <div t-attf-id="wrap_product_category_#{category.get('slug', '')}_gap_4" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.product_l2').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[5]"/>

</div>

</t>
</template>
</odoo>
