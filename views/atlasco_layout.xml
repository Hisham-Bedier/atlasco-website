<!-- MULTI-PANEL CASCADING SIDEMENU (Figma 4300:1039) -->
<div class="atl-sidemenu">
    <div class="atl-sidemenu-overlay"></div>
    <nav class="atl-sidemenu-panels">

        <!-- L1 + L2 are dynamic now — was 2 of the 3 hand-authored panel
             levels (About/Industries/Products/Services/Careers submenus),
             migrated to nested website.menu records (see
             WebsiteMenu._migrate_atlasco_sidemenu in models/website.py) so
             the native Menu Editor actually controls the burger menu too,
             not just the top navbar. The JS (atlasco.js initSideMenu) only
             ever queries by class/data attribute at runtime, so it needed
             zero changes — this just has to keep emitting the same markup
             shape it always has.

             L3 (Products' 10 categories -> specific product types) stays
             hand-authored below: website.menu hard-caps at 2 levels of
             hierarchy ("Menus cannot have more than two levels of
             hierarchy" — a real Odoo core constraint, confirmed by hitting
             it directly), so a 3rd level structurally cannot live there.
             "Has a sub-panel" is checked via atlasco_sm_target, not
             child_id, for exactly this reason: Products' 10 L2 category
             items DO open a sub-panel but have no website.menu children
             (their L3 is the hardcoded panels further down). -->
        <t t-set="sm_root" t-value="request.website.menu_id"/>

        <!-- PANEL 1 — L1 -->
        <div class="atl-sm-panel atl-sm-l1">
            <div class="atl-sm-logo">ATLASCO EGYPT</div>
            <t t-foreach="sm_root.child_id" t-as="l1">
                <a t-attf-class="atl-sm-item#{'' if l1.atlasco_sm_target else ' atl-sm-item-leaf'}"
                   t-att-data-sm-target="l1.atlasco_sm_target or None" t-att-href="l1.url">
                    <span t-esc="l1.atlasco_sidemenu_label or l1.name"/>
                    <t t-if="l1.atlasco_sm_target"><span class="atl-sm-chev">&#8250;</span></t>
                </a>
            </t>
        </div>

        <!-- PANEL 2 — L2 -->
        <t t-foreach="sm_root.child_id" t-as="l1">
            <t t-if="l1.atlasco_sm_target">
                <div class="atl-sm-panel atl-sm-l2" t-att-data-sm-panel="l1.atlasco_sm_target">
                    <div class="atl-sm-title" t-esc="l1.atlasco_sidemenu_label or l1.name"/>
                    <!-- Services: read straight from atlasco.service instead of
                         separately-maintained website.menu children, so a
                         service added via Website > Content > Services shows up
                         here immediately with no extra menu-editing step. -->
                    <t t-if="l1.url == '/services'">
                        <t t-foreach="request.env['atlasco.service'].sudo().search([], order='sequence, id')" t-as="svc">
                            <a class="atl-sm-item atl-sm-item-leaf" t-att-href="svc.href()">
                                <span t-esc="svc.sidemenu_label or svc.name"/>
                            </a>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-foreach="l1.child_id" t-as="l2">
                            <a t-attf-class="atl-sm-item#{'' if l2.atlasco_sm_target else ' atl-sm-item-leaf'}"
                               t-att-data-sm-target="l2.atlasco_sm_target or None" t-att-href="l2.url">
                                <span t-esc="l2.name"/>
                                <t t-if="l2.atlasco_sm_target"><span class="atl-sm-chev">&#8250;</span></t>
                            </a>
                        </t>
                    </t>
                </div>
            </t>
        </t>

        <!-- PANEL 3 — L3 (Air Compressors) -->
        <div class="atl-sm-panel atl-sm-l3" data-sm-panel="air-compressors">
