<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_atlasco_partner_list" model="ir.ui.view">
    <field name="name">atlasco.partner.list</field>
    <field name="model">atlasco.partner</field>
    <field name="arch" type="xml">
      <tree string="Partners"><field name="sequence" widget="handle"/>
        <field name="name"/><field name="slug"/><field name="category"/>
        <field name="country"/><field name="show_on_home"/><field name="link"/>
      </tree>
    </field>
  </record>
  <record id="view_atlasco_partner_form" model="ir.ui.view">
    <field name="name">atlasco.partner.form</field>
    <field name="model">atlasco.partner</field>
    <field name="arch" type="xml">
      <form string="Partner"><sheet>
        <field name="logo_image" widget="image" class="oe_avatar" options="{'size': [120, 120]}"/>
        <group>
          <group><field name="name"/><field name="slug"/><field name="category"/><field name="country"/></group>
          <group><field name="show_on_home"/><field name="home_label"/><field name="link" placeholder="/partners/&lt;slug&gt;"/></group>
        </group>
        <group string="Detail Page Banner"><field name="banner_image" widget="image" options="{'size': [0, 200]}"/></group>
        <group string="Advanced — static asset paths (leave empty, use the uploads above instead)">
          <field name="logo"/><field name="banner"/>
        </group>
        <group><field name="tagline"/><field name="headline"/><field name="subtitle"/></group>
        <notebook>
          <page string="Body"><field name="body_html" widget="html"/><field name="together"/></page>
          <page string="KPIs"><field name="kpi_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="value"/><field name="label"/></tree></field></page>
          <page string="Why Atlasco"><field name="why_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="title"/><field name="description"/></tree></field></page>
          <page string="Links"><field name="link_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="kind"/><field name="text"/><field name="url"/><field name="external_url"/></tree></field></page>
          <page string="Featured Technology"><group><field name="tech_name"/><field name="tech_description"/><field name="tech_video"/></group></page>
          <page string="Service Programs"><field name="service_program_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="subtitle"/><field name="description"/><field name="features" widget="text"/></tree></field></page>
          <page string="Certifications"><field name="certification_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="image" widget="image" options="{'size': [64, 64]}"/><field name="image_path"/></tree></field></page>
        </notebook>
      </sheet></form>
    </field>
  </record>
  <record id="action_atlasco_partner" model="ir.actions.act_window">
    <field name="name">Partners</field><field name="res_model">atlasco.partner</field>
    <field name="view_mode">tree,form</field>
  </record>
  <menuitem id="menu_atlasco_partner" name="Partners" action="action_atlasco_partner"
            parent="atlasco_website.menu_atlasco_group_catalog" sequence="10"/>

  <!-- ClickUp 869eg533x: idempotently migrate the 23 original partners
       (previously a hardcoded dict in controllers/main.py) into real
       records here (runs on install + upgrade; never touches a slug that
       already exists). -->
  <function model="atlasco.partner" name="_seed_legacy_partners"/>
</odoo>
