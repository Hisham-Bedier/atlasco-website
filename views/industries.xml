<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="industries" name="Industries We Serve">
<t t-call="atlasco_website.atlasco_layout">

<!-- Page-scoped oe_structure (same pattern as /about, /culture) so Insert
     Blocks has a valid drop target between the sections below. -->
<div id="wrap_industries" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.industries').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]">

<!-- Genuinely-empty "gap" oe_structure divs threaded between the sections
     below are real Odoo-native Insert-Blocks drop targets - see the long
     root-cause comment on wrap_about in atlasco_about_page.xml. -->
<div id="wrap_industries_gap_0" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.industries').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[1]"/>

<t t-set="hero_bg" t-value="request.env['atlasco.page.hero'].sudo()._image_url('industries')"/>
<t t-set="style_industries_hero" t-value="request.env['atlasco.block.style'].sudo()._get('industries_hero')"/>
<section class="atl-page-hero atl-industries-hero atl-font-editable o_editable" t-att-data-style-model="'atlasco.block.style'" t-att-data-style-id="style_industries_hero.id" t-attf-style="#{'background-image:url(%s);background-size:cover;background-position:center;' % hero_bg if hero_bg else ''}--atl-dyn-font-family:#{style_industries_hero.font_family or ''};--atl-dyn-font-size:#{style_industries_hero.font_size or ''};">
    <div class="atl-page-hero-inner">
        <div class="atl-section-label">Industries We Serve</div>
        <h1 style="font-size:var(--atl-dyn-font-size, 52px);font-weight:900;color:white;line-height:1.05;margin-bottom:16px;">Industries We Serve</h1>
        <p>Providing specialized air, fluid, and reliability solutions across Egypt's most demanding industrial sectors.</p>
        <div class="atl-breadcrumb">
            <a href="/">Home</a>
            <span class="sep">/</span>
            <span>Industries We Serve</span>
        </div>
    </div>
</section>

<div id="wrap_industries_gap_1" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.industries').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[2]"/>

<section class="atl-industries-intro">
    <div class="atl-section-label">From Precision to Performance</div>
    <h2 class="atl-section-title">Industrial Excellence</h2>
</section>

<div id="wrap_industries_gap_2" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.industries').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[3]"/>

