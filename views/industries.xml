    <a href="/industries/oil-gas" class="atl-industry-card">
        <img src="/atlasco_website/static/src/img/industries/cards/card-oil-gas.jpg" alt="Oil Gas industry" class="atl-industry-placeholder"/>
        <div class="atl-industry-card-overlay"></div>
        <div class="atl-industry-card-label">
            <span class="tag">Industry</span>
            <h3>OIL &amp; GAS</h3>
            <p class="ind-desc">Atlasco Egypt delivers advanced air and reliability solutions for the toughest oil &amp; gas environments—ensuring safe and uninterrupted operations.</p>
            <div class="ind-line"></div>
        </div>
    </a>
    <a href="/industries/pharmaceutical" class="atl-industry-card">
