<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlasco_industry_product_list" model="ir.ui.view">
        <field name="name">atlasco.industry.product.list</field>
        <field name="model">atlasco.industry.product</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="industry_slug"/>
                <field name="name"/>
                <field name="slug" string="URL Slug" optional="hide"/>
                <field name="link_url" string="Link Override"/>
                <field name="image" widget="image" options="{'size': [64, 64]}"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_atlasco_industry_product_form" model="ir.ui.view">
        <field name="name">atlasco.industry.product.form</field>
        <field name="model">atlasco.industry.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="industry_slug"/>
                            <field name="slug"/>
                            <field name="link_url"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="name"/>
                        <field name="desc"/>
                        <field name="cta_label"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_atlasco_industry_product_search" model="ir.ui.view">
        <field name="name">atlasco.industry.product.search</field>
        <field name="model">atlasco.industry.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="industry_slug"/>
                <group expand="1" string="Group By">
                    <filter string="Industry" name="group_by_industry" context="{'group_by': 'industry_slug'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_atlasco_industry_product" model="ir.actions.act_window">
        <field name="name">Industry Products</field>
        <field name="res_model">atlasco.industry.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_industry': 1}</field>
        <field name="help" type="html">
            <p>Each card shows in the "Technologies Behind Reliable Industry" section on that
                industry's detail page. Every industry has its own set of cards — replacing an
                image for one industry never affects another. Grouped by Industry.</p>
        </field>
    </record>

    <menuitem id="menu_atlasco_industry_product"
              name="Industry Products"
              parent="atlasco_website.menu_atlasco_group_catalog"
              action="action_atlasco_industry_product"
              sequence="40"/>

    <!-- Idempotent seed from the controller lists (runs on install + upgrade) -->
    <function model="atlasco.industry.product" name="_seed_from_controller"/>
    <!-- Idempotent backfill of cta_label on rows that predate the field -->
    <function model="atlasco.industry.product" name="_backfill_cta_label"/>
</odoo>
