<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
  Careers — Option B (12-7 redesign, pixel-faithful to "Careers - B.dc.html" showCareersB).
  EDITABLE WEBSITE PAGE: no t-field / no t-foreach / no atlasco.content binding anywhere.
  All copy is plain editable text; all images are plain <img src> (editor "replace media");
  the hero + cross-link photo are section editor-backgrounds (oe_img_bg ...), so the Website
  Editor can swap them. Real Atlasco assets preserved (careers hero photo, gem-event video).
  Served via controller with website=True → Website Editor toolbar active on /careers.
-->
<template id="careers" name="Careers - Build Your Career (Option B)">
<t t-call="atlasco_website.atlasco_layout">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&amp;family=IBM+Plex+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<style>
  .crb{--g:#126A3A;--gd:#0E5730;--acc:#4ADE80;--ink:#0B1620;--bg:#F7F5EF;font-family:'IBM Plex Sans',system-ui,sans-serif;color:#16242F;background:var(--bg);overflow-x:hidden}
  .crb h1,.crb h2,.crb h3,.crb h4{font-family:'Archivo',system-ui,sans-serif;margin:0;letter-spacing:-.02em;color:var(--ink)}
  .crb p{margin:0}
  .crb a{text-decoration:none}
  .crb-eyebrow{display:inline-flex;align-items:center;gap:8px;padding:7px 15px;border-radius:100px;background:#E8F2EC;color:var(--g);font-size:12px;font-weight:700;letter-spacing:.08em}
  .crb-eyebrow.on-dark{background:rgba(74,222,128,.14);color:var(--acc)}
  .crb-sec{padding:clamp(56px,7vw,96px) clamp(20px,5vw,72px)}
  .crb-in{max-width:var(--atl-content-max-width);margin:0 auto}
  .crb-in-narrow{max-width:var(--atl-content-max-width);margin:0 auto}
  /* HERO (dark photographic banner, per design "HERO BANNER") — editable background photo */
  .crb-hero{position:relative;min-height:470px;display:flex;align-items:center;overflow:hidden;background-color:#0A1710}
  .crb-hero-scrim{position:absolute;inset:0;background:linear-gradient(100deg,rgba(7,18,11,.94) 0%,rgba(7,18,11,.74) 42%,rgba(7,18,11,.22) 100%);pointer-events:none}
  .crb-hero-inner{position:relative;max-width:var(--atl-content-max-width);width:100%;margin:0 auto;padding:60px clamp(20px,5vw,40px)}
  .crb-hero h1{margin-top:22px;font-size:clamp(40px,5.6vw,58px);line-height:1.03;font-weight:900;letter-spacing:-.03em;color:#fff;max-width:740px}
  .crb-hero h1 .g{color:var(--acc);position:relative;display:inline-block}
  .crb-hero-body{max-width:560px;margin:22px 0 0;font-size:clamp(15px,1.9vw,16.5px);line-height:1.7;color:#CFD8D0}
  .crb-hero-ctas{margin-top:30px;display:flex;flex-wrap:wrap;gap:14px}
  .crb-hero .crb-btn-ghost{border-color:rgba(255,255,255,.32);background:transparent;color:#fff}
  .crb-hero .crb-btn-ghost:hover{border-color:var(--acc);color:#fff;background:rgba(255,255,255,.06)}
  .crb-btn{display:inline-flex;align-items:center;gap:12px;padding:16px 26px;border-radius:100px;background:var(--g);color:#fff;font-weight:700;font-size:16px;box-shadow:0 12px 28px rgba(18,106,58,.30);transition:transform .2s,background .2s}
  .crb-btn:hover{transform:translateY(-3px);color:#fff}
  .crb-btn .arrowcircle{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--acc);color:#0B3D22;transition:transform .25s}
  .crb-btn:hover .arrowcircle{transform:translateX(2px)}
  .crb-btn-ghost{padding:16px 26px;border-radius:100px;border:1.5px solid rgba(16,36,50,.18);background:#fff;color:#16242F;font-weight:700;font-size:16px;transition:all .2s}
  .crb-btn-ghost:hover{border-color:var(--g);color:var(--ink)}
  /* WHY (editorial 2-col) */
  .crb-why-grid{display:grid;grid-template-columns:330px 1fr;gap:clamp(30px,4vw,56px);align-items:start}
  .crb-why-aside{position:sticky;top:96px}
  .crb-why-aside h2{margin-top:12px;font-size:clamp(28px,3.6vw,40px);line-height:1.1;font-weight:800}
  .crb-why-aside p{margin-top:16px;color:#5C6B76;font-size:15.5px;line-height:1.7}
  .crb-why-row{display:flex;gap:26px;padding:24px 0;border-top:1px solid #ECF0ED}
  .crb-why-num{font-family:'Archivo';font-weight:800;font-size:34px;color:#B7D8C1;line-height:1;flex-shrink:0;width:44px}
  .crb-why-row h3{font-size:20px;font-weight:700;letter-spacing:-.01em}
  .crb-why-row p{font-size:15px;line-height:1.65;color:#5C6B76;margin-top:8px;max-width:640px}
  /* BENEFITS (dark green, 2-col checklist) */
  .crb-ben{background:var(--gd)}
  .crb-ben-head{max-width:640px;margin-bottom:36px}
  .crb-ben-head h2{margin-top:16px;font-size:clamp(28px,3.6vw,42px);line-height:1.1;font-weight:800;color:#fff}
  .crb-ben-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 44px}
  .crb-ben-row{display:flex;gap:16px;padding:20px 0;border-top:1px solid rgba(255,255,255,.14)}
  .crb-ben-ic{width:30px;height:30px;border-radius:8px;background:rgba(74,222,128,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .crb-ben-row h4{font-size:16.5px;font-weight:700;color:#fff}
  .crb-ben-row p{font-size:14px;line-height:1.6;color:#B9D4C1;margin-top:6px}
  /* OPENINGS */
  .crb-open-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:26px}
  .crb-open-head h2{margin-top:12px;font-size:clamp(28px,3.6vw,42px);line-height:1.1;font-weight:800}
  .crb-open-count{font-weight:700;color:var(--g);font-size:15px}
  .crb-filter{display:flex;gap:16px;align-items:center;flex-wrap:wrap;background:#fff;border:1px solid #E6EBE7;border-radius:14px;padding:14px 16px;margin-bottom:26px}
  .crb-search{position:relative;flex:1;min-width:200px}
  .crb-search svg{position:absolute;left:14px;top:50%;transform:translateY(-50%)}
  .crb-search input{width:100%;font-family:inherit;font-size:14px;padding:11px 14px 11px 38px;border:1px solid #DCE2DE;border-radius:9px;outline:none;color:var(--ink);background:#fbfaf5}
  .crb-search input:focus{border-color:var(--g)}
  .crb-chips{display:flex;flex-wrap:wrap;gap:8px}
  .crb-chip{border:1px solid #D8DEDA;background:#fff;color:#3A434E;cursor:pointer;font-family:inherit;font-size:13px;font-weight:600;padding:8px 15px;border-radius:999px;transition:all .15s;white-space:nowrap}
  .crb-chip:hover{border-color:var(--g);color:var(--g)}
  .crb-chip.active{border-color:var(--g);background:var(--g);color:#fff}
  .crb-div{width:1px;height:24px;background:#DCE2DE}
  .crb-jobs{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .crb-jobcard{border:1px solid rgba(16,36,50,.08);border-radius:16px;background:#fff;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s,border-color .2s}
  .crb-jobcard:hover{transform:translateY(-3px);box-shadow:0 22px 44px -28px rgba(11,22,32,.3);border-color:var(--g)}
  .crb-jobcard[hidden]{display:none}
  .crb-jobcard-body{padding:24px 24px 22px;flex:1}
  .crb-jobtags{display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
  .crb-jobtag-dept{background:#EAF6EE;color:var(--g);font-weight:700;font-size:12px;padding:5px 11px;border-radius:999px}
  .crb-jobtag{display:flex;align-items:center;gap:5px;font-size:12.5px;color:#7C858D;font-weight:600}
  .crb-jobcard h3{font-weight:800;font-size:20px;color:var(--ink);letter-spacing:-.015em}
  .crb-jobcard-blurb{font-size:14.5px;line-height:1.65;color:#5A6472;margin-top:10px}
  .crb-jobdetail{margin-top:18px}
  .crb-jobdetail-lbl{font-weight:700;font-size:11.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--g);margin-bottom:12px}
  .crb-jobpoints{display:flex;flex-direction:column;gap:10px}
  .crb-jobpoint{display:flex;gap:11px;align-items:flex-start}
  .crb-jobpoint svg{margin-top:3px;flex-shrink:0}
  .crb-jobpoint span{font-size:14px;line-height:1.55;color:#41505E}
  .crb-jobfoot{display:flex;gap:10px;padding:16px 24px;border-top:1px solid #EEF2EF;background:#FAFCFB}
  .crb-jobfoot .toggle{background:#fff;color:#3A434E;border:1px solid #DCE2DE;cursor:pointer;font-family:inherit;font-weight:600;font-size:14px;padding:11px 18px;border-radius:9px}
  .crb-jobfoot .apply{flex:1;background:var(--g);color:#fff;border:0;cursor:pointer;font-family:inherit;font-weight:700;font-size:14px;padding:11px 18px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:background .2s}
  .crb-jobfoot .apply:hover{background:var(--gd);color:#fff}
  .crb-nojobs{text-align:center;padding:56px 20px;border:1px dashed #D3DBD5;border-radius:14px;color:#7C858D;margin-top:16px}
  /* PROCESS (vertical timeline) */
  .crb-proc{background:#F1F5F7}
  .crb-proc-head{text-align:center;margin-bottom:44px}
  .crb-proc-head h2{margin-top:12px;font-size:clamp(28px,3.4vw,38px);line-height:1.1;font-weight:800}
  .crb-proc-row{display:flex;gap:24px}
  .crb-proc-rail{display:flex;flex-direction:column;align-items:center}
  .crb-proc-node{width:50px;height:50px;border-radius:50%;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;flex-shrink:0;font-family:'Archivo'}
  .crb-proc-line{flex:1;width:2px;background:#D3E2D9;margin:8px 0;min-height:14px}
  .crb-proc-text{padding-bottom:30px;padding-top:8px}
  .crb-proc-text h3{font-weight:700;font-size:20px;color:var(--ink);letter-spacing:-.01em}
  .crb-proc-text p{font-size:15px;line-height:1.65;color:#5A6472;margin-top:6px}
  /* SEND CV + CROSS-LINK (2-col split) */
  .crb-split{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .crb-card{border-radius:20px;padding:44px}
  .crb-card.mint{background:#EDF4EF;border:1px solid #DCEAE0}
  .crb-card.dark{position:relative;overflow:hidden;background-color:var(--gd);color:#fff}
  .crb-card.dark .crb-card-scrim{position:absolute;inset:0;background:linear-gradient(120deg,rgba(14,87,48,.90),rgba(11,61,34,.86));pointer-events:none}
  .crb-card.dark .crb-card-inner{position:relative}
  .crb-card h2{font-size:clamp(22px,2.4vw,27px);line-height:1.15;font-weight:800;letter-spacing:-.02em}
  .crb-card.dark h2{color:#fff}
  .crb-card p{margin-top:12px;font-size:15.5px;line-height:1.7;color:#5A6472}
  .crb-card.dark p{color:#C5D9CC}
  .crb-card .cta{margin-top:22px;display:inline-flex;align-items:center;gap:9px;font-family:inherit;font-weight:700;font-size:15px;padding:14px 26px;border-radius:10px;background:var(--g);color:#fff;cursor:pointer;border:0;transition:background .2s}
  .crb-card .cta:hover{background:var(--gd);color:#fff}
  .crb-card.dark .cta{background:#fff;color:var(--gd);font-weight:800}
  .crb-card.dark .cta:hover{background:#E9F4EC;color:var(--gd)}
  /* APPLY FORM (dark) — preserves live /contact/submit form */
  .crb-apply{background:var(--ink)}
  .crb-apply-head{text-align:center;max-width:640px;margin:0 auto 40px}
  .crb-apply-head h2{margin-top:16px;font-size:clamp(28px,3.6vw,44px);line-height:1.08;font-weight:800;color:#fff}
  .crb-form{max-width:820px;margin:0 auto;background:#12222E;border:1px solid rgba(255,255,255,.06);border-radius:26px;padding:clamp(24px,4vw,42px)}
  .crb-form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .crb-field{display:flex;flex-direction:column;margin-top:18px}
  .crb-field:first-child,.crb-form-row .crb-field{margin-top:0}
  .crb-form-row{margin-top:18px}
  .crb-form-row:first-of-type{margin-top:0}
  .crb-field label{font-size:13px;font-weight:600;color:rgba(255,255,255,.8);margin-bottom:7px}
  .crb-field input,.crb-field select,.crb-field textarea{border:1.5px solid rgba(255,255,255,.14);border-radius:12px;padding:13px 15px;font-size:14.5px;background:var(--ink);color:#fff;font-family:inherit}
  .crb-field input:focus,.crb-field select:focus,.crb-field textarea:focus{outline:none;border-color:var(--acc)}
  .crb-form-note{margin-top:18px;font-size:13.5px;color:rgba(255,255,255,.6)}
  .crb-form-note a{color:var(--acc)}
  .crb-submit{margin-top:22px;border:0;cursor:pointer;display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border-radius:100px;background:var(--g);color:#fff;font-weight:700;font-size:15px;font-family:inherit;transition:background .2s}
  .crb-submit:hover{background:var(--gd)}
  .crb [data-reveal]{opacity:0}
  @media(max-width:960px){.crb-why-grid{grid-template-columns:1fr;gap:30px}.crb-why-aside{position:static}}
  @media(max-width:820px){.crb-ben-grid,.crb-jobs,.crb-split{grid-template-columns:1fr}}
  @media(max-width:640px){.crb-form-row{grid-template-columns:1fr}}
</style>

<div class="crb">

<!-- Page-scoped oe_structure (same pattern as /services, /about, /culture)
     so Insert Blocks has a valid drop target on this page. -->
<div id="wrap_careers" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.careers').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]">

  <!-- Genuinely-empty "gap" oe_structure divs threaded between the sections
       below are real Odoo-native Insert-Blocks drop targets - see the long
       root-cause comment on wrap_about in atlasco_about_page.xml. -->
  <div id="wrap_careers_gap_0" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.careers').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[1]"/>

  <!-- ============ HERO BANNER (dark photographic, per design) — editable background photo ============ -->
  <t t-set="hero_bg" t-value="request.env['atlasco.page.hero'].sudo()._image_url('careers')"/>
  <div class="atl-about-hero atl-about-hero--careers">
    <img t-att-src="hero_bg or '/atlasco_website/static/src/img/banners/careers.jpg'" t-att-alt="content.careers_hero_banner_alt or 'Careers at Atlasco'" class="atl-about-hero-img"/>
  </div>
  <t t-set="style_careers_hero" t-value="request.env['atlasco.block.style'].sudo()._get('careers_hero')"/>
  <div id="wrap_careers_gap_1" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.careers').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[2]"/>

  <section class="crb-sec atl-font-editable o_editable" t-att-data-style-model="'atlasco.block.style'" t-att-data-style-id="style_careers_hero.id" t-attf-style="text-align:center;padding-bottom:0;--atl-dyn-font-family:#{style_careers_hero.font_family or ''};--atl-dyn-font-size:#{style_careers_hero.font_size or ''};">
    <div class="crb-in" style="margin:0 auto;padding:clamp(30px,4vw,48px) clamp(20px,5vw,40px) 0;">
      <span style="display:inline-flex;align-items:center;gap:8px;background:var(--g);color:#fff;font-size:11.5px;font-weight:700;letter-spacing:.11em;padding:8px 15px;border-radius:6px">35 YEARS OF CUSTOMER-CENTERED APPROACH</span>
      <h1 style="margin:18px 0 0;color:#17251c;">Your next role is an <span class="g">opportunity to build.</span></h1>
      <p style="margin:16px auto 0;max-width:640px;color:#4a5751;font-size:17px;line-height:1.6;">Explore roles across engineering, service, sales, and logistics &#8212; and take the next step in a company that grows its people for the long term.</p>
      <div class="crb-hero-ctas" style="justify-content:center;margin-top:24px;display:flex;gap:14px;flex-wrap:wrap;">
        <a t-att-href="style_careers_hero.cta_url or '#openings'" class="crb-btn">Explore Open Roles</a>
        <a href="/culture" class="crb-btn-ghost">See Life at Atlasco</a>
      </div>
    </div>
  </section>

  <!-- ============ CAREERS VIDEO ============ -->
  <!-- Ticket: client couldn't find a real control to change this video - the
       old approach exposed the raw URL as editable text below the video and
       relied on the generic website-editor save picking it up, but that
       never actually wrote back to careers_hero_video (the field the video
       itself reads), so edits appeared to work but the video never changed.
       Fixed the same way the /about background video already works: wrap
       the video in data-video-model/id/field attributes and use the
       AtlascoVideoReplace snippet option (see atlasco_snippet_options.xml),
       which does a direct orm.write() on save instead of relying on the
       generic text-diff save path. -->
  <div id="wrap_careers_gap_2" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.careers').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[3]"/>

  <section class="crb-sec crb-video-sec" style="padding-top:0;">
    <div class="crb-in" style="margin:0 auto;padding:clamp(28px,4vw,44px) clamp(20px,5vw,40px) 0;">
      <!-- The "o_editable" class here is required, not cosmetic: the Website Editor's
           click-to-select logic only matches a custom snippet-option selector (see
           AtlascoVideoReplace in atlasco_snippet_options.xml) against elements that sit
           inside its recognized "editable area" (getEditableArea(), built from
           .o_editable-classed elements). This block has no data-oe-model of its own (that
           would make it directly raw-HTML/contenteditable instead), so without a static
           .o_editable class here the custom "Replace video" option never appears no matter
           what is clicked inside it. -->
      <div class="crb-video-frame o_editable" t-att-data-video-model="content._name" t-att-data-video-id="content.id" data-video-field="careers_hero_video" style="position:relative;width:100%;aspect-ratio:16/9;border-radius:16px;overflow:hidden;box-shadow:0 24px 60px rgba(11,22,16,.18);background:#0A1710;">
        <video class="crb-video-el" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;"
               t-att-src="content.careers_hero_video"
               autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline"
               controls="controls" preload="metadata" aria-label="Life at Atlasco">
          <source t-att-src="content.careers_hero_video" type="video/mp4"/>
        </video>
        <!-- Invisible in normal browsing; shown only in edit mode, as a defensive
             click-catcher in case a click lands on the native video controls.
             t-ignore keeps this leaf div from being individually swept up by Odoo's
             generic raw-HTML branding (data-oe-model/contenteditable), which would
             otherwise compete with the click reaching the option above. -->
        <div class="atl-video-select-overlay" t-ignore="1"></div>
        <!-- Editor: select this video block, then use the "Replace video" button in the
             snippet options panel to upload/replace the mp4 (persists to careers_hero_video). -->
      </div>
    </div>
  </section>

  <!-- ============ WHY BUILD YOUR CAREER HERE (editorial 2-col) ============ -->
  <div id="wrap_careers_gap_3" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.careers').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[4]"/>

  <section id="why" class="crb-sec">
    <div class="crb-in crb-why-grid">
      <div class="crb-why-aside" data-reveal="1">
        <span class="crb-eyebrow">Why Atlasco</span>
        <h2>Why build your career here?</h2>
        <p>Five reasons our engineers, sales professionals, and specialists choose to grow with us.</p>
      </div>
      <div>
        <div class="crb-why-row" data-reveal="1">
          <div class="crb-why-num">01</div>
          <div>
            <h3>Real Impact on Egyptian Industry</h3>
            <p>Your work directly supports the infrastructure and production lines that power Egypt&#8217;s leading industrial sectors.</p>
          </div>
        </div>
        <div class="crb-why-row" data-reveal="1">
          <div class="crb-why-num">02</div>
          <div>
            <h3>A Legacy You Can Be Proud Of</h3>
            <p>Join a company with 35+ years of engineering heritage, trusted by Egypt&#8217;s most demanding industrial clients.</p>
          </div>
        </div>
        <div class="crb-why-row" data-reveal="1">
          <div class="crb-why-num">03</div>
          <div>
            <h3>Technical Depth &amp; Domain Mastery</h3>
            <p>Work alongside engineers who specialize in reliability, compressed air, fluid analysis, and predictive maintenance.</p>
          </div>
        </div>
        <div class="crb-why-row" data-reveal="1">
          <div class="crb-why-num">04</div>
          <div>
            <h3>People-First Environment</h3>
            <p>We invest in the wellbeing and development of our people &#8212; because great results come from teams that feel valued.</p>
          </div>
        </div>
        <div class="crb-why-row" data-reveal="1">
          <div class="crb-why-num">05</div>
          <div>
            <h3>Room to Grow</h3>
            <p>Clear career paths, mentorship from senior engineers, and access to international training through PrimeGear Academy.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ EMPLOYEE BENEFITS (dark green, 2-col checklist) ============ -->
