<script>
(function(){
  var root = document.querySelector('.crb');
  if(!root) return;

  /* --- scroll reveal --- */
  var els = [].slice.call(root.querySelectorAll('[data-reveal]'));
  var reduce = window.matchMedia &amp;&amp; window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  els.forEach(function(el){ el.style.transition='opacity .7s cubic-bezier(.22,.61,.36,1), transform .7s cubic-bezier(.22,.61,.36,1)'; el.style.transform='translateY(26px)'; });
  function show(el){ el.style.opacity='1'; el.style.transform='none'; el.setAttribute('data-shown','1'); }
  if (reduce){ els.forEach(show); }
  else {
    var tick=function(){ var vh=window.innerHeight||document.documentElement.clientHeight;
      for (var i=0;i&lt;els.length;i++){ var el=els[i]; if(el.getAttribute('data-shown')) continue; var r=el.getBoundingClientRect(); if(r.top&lt;vh*0.92 &amp;&amp; r.bottom&gt;0) show(el); } };
    /* Odoo's website layout scrolls #wrapwrap, not window (html/body are
       overflow:hidden) — a plain window scroll listener never fires on a
       real page, so anything below the initial fold stayed permanently
       hidden. */
    (document.getElementById('wrapwrap')||window).addEventListener('scroll',tick,{passive:true}); window.addEventListener('resize',tick,{passive:true});
    var revealInterval=setInterval(function(){ tick(); if(!els.some(function(el){return !el.getAttribute('data-shown');})) clearInterval(revealInterval); },150);
    [0,90,260,600].forEach(function(t){ setTimeout(tick,t); });
  }

  /* --- job card expand/collapse --- */
  root.querySelectorAll('.crb-jobfoot .toggle').forEach(function(btn){
    btn.addEventListener('click', function(){
      var card = btn.closest('.crb-jobcard');
      var detail = card.querySelector('.crb-jobdetail');
      if(!detail) return;
      var open = !detail.hasAttribute('hidden');
      if(open){ detail.setAttribute('hidden','hidden'); btn.textContent='View details'; }
      else { detail.removeAttribute('hidden'); btn.textContent='Hide details'; }
    });
  });

  /* --- "Apply Now" ties the shared apply form to the clicked job, with no
     manual re-selection --- */
  var applyJobIdEl = document.getElementById('crbApplyJobId');
  var applyPositionEl = document.getElementById('crbApplyPosition');
  root.querySelectorAll('.crb-jobfoot .apply').forEach(function(link){
    link.addEventListener('click', function(){
      if(!applyJobIdEl || !applyPositionEl) return;
      applyJobIdEl.value = link.getAttribute('data-job-id') || '';
      applyPositionEl.value = link.getAttribute('data-job-title') || '';
    });
  });

  /* --- filters (dept chips + loc chips + search) --- */
  var dept='All', loc='All', q='';
  var cards = [].slice.call(root.querySelectorAll('.crb-jobcard'));
  var countEl = root.querySelector('#crbJobCount');
  var noJobs = root.querySelector('#crbNoJobs');
  function apply(){
    var shown=0;
    cards.forEach(function(c){
      var okDept = dept==='All' || c.getAttribute('data-dept')===dept;
      var okLoc = loc==='All' || c.getAttribute('data-loc')===loc;
      var okQ = !q || (c.getAttribute('data-search')||'').indexOf(q)>=0;
      if(okDept &amp;&amp; okLoc &amp;&amp; okQ){ c.removeAttribute('hidden'); shown++; }
      else { c.setAttribute('hidden','hidden'); }
    });
    if(countEl) countEl.textContent = shown;
    if(noJobs){ if(shown===0) noJobs.removeAttribute('hidden'); else noJobs.setAttribute('hidden','hidden'); }
  }
  root.querySelectorAll('#crbDeptChips .crb-chip').forEach(function(ch){
    ch.addEventListener('click', function(){
      root.querySelectorAll('#crbDeptChips .crb-chip').forEach(function(x){x.classList.remove('active');});
      ch.classList.add('active'); dept=ch.getAttribute('data-dept'); apply();
    });
  });
  root.querySelectorAll('#crbLocChips .crb-chip').forEach(function(ch){
    ch.addEventListener('click', function(){
      root.querySelectorAll('#crbLocChips .crb-chip').forEach(function(x){x.classList.remove('active');});
      ch.classList.add('active'); loc=ch.getAttribute('data-loc'); apply();
    });
  });
  var search = root.querySelector('#crbSearch');
  if(search) search.addEventListener('input', function(e){ q=(e.target.value||'').toLowerCase(); apply(); });
  var reset = root.querySelector('#crbResetFilters');
  if(reset) reset.addEventListener('click', function(){
    dept='All'; loc='All'; q='';
    if(search) search.value='';
    root.querySelectorAll('#crbDeptChips .crb-chip').forEach(function(x){x.classList.toggle('active', x.getAttribute('data-dept')==='All');});
    root.querySelectorAll('#crbLocChips .crb-chip').forEach(function(x){x.classList.toggle('active', x.getAttribute('data-loc')==='All');});
    apply();
  });
})();
</script>

</t>
