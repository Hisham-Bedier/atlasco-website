            </div>
        </div>

        <div class="atl-tab-content" data-tab-content="fluid-analysis">
            <div class="atl-tab-text">
                <h3 t-field="content.home_sol_fluid_title"/>
                <p class="atl-tab-sub" t-field="content.home_sol_fluid_sub"/>
                <p t-field="content.home_sol_fluid_body"/>
                <ul class="atl-tab-checks">
                    <t t-foreach="content.home_solution_check_ids.filtered(lambda c: c.tab == 'fluid')" t-as="chk">
                    <li><span t-field="chk.text"/></li>
                    </t>
                </ul>
                <a href="/products/fluid-analysis" class="atl-tab-link" t-field="content.home_sol_fluid_link"/>
            </div>
            <div class="atl-tab-image">
                <img src="/atlasco_website/static/src/img/solutions/fluid-lubrication-analysis.jpg" alt="Fluid &amp; Lubrication Analysis"/>
            </div>
        </div>

        <div class="atl-tab-content" data-tab-content="condition-monitoring">
            <div class="atl-tab-text">
                <h3 t-field="content.home_sol_cm_title"/>
                <p class="atl-tab-sub" t-field="content.home_sol_cm_sub"/>
                <p t-field="content.home_sol_cm_body"/>
                <ul class="atl-tab-checks">
                    <t t-foreach="content.home_solution_check_ids.filtered(lambda c: c.tab == 'cm')" t-as="chk">
                    <li><span t-field="chk.text"/></li>
