    <!-- Footer line removed per Youssef 2026-06-07 (Yasmine-AI) -->
</section>


<!-- CHAIRMAN MESSAGE BANNER removed per Youssef 2026-05-14 — kept content on /about page only -->

<!-- SEPARATOR — flank (Separator improvement handoff 12-7) -->
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&amp;family=Manrope:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<style>
  .asep{--accent:#2fa85a;font-family:Manrope,system-ui,sans-serif;color:#17251c;background:#f4f1e8}
  .asep-band{position:relative;height:92px;background:#f4f1e8;overflow:hidden}
  .asep-band svg{position:absolute;left:0;top:0;width:100%;height:92px;display:block}
  .asep-hex{position:absolute;background:var(--accent);clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%)}
  .asep-hex.h1{left:23%;top:30px;width:18px;height:20px;opacity:.13;animation:asepdrift 8s ease-in-out infinite alternate}
  .asep-hex.h2{left:50%;top:22px;width:22px;height:25px;opacity:.12;animation:asepdrift 10s ease-in-out infinite alternate-reverse}
  .asep-hex.h3{left:77%;top:30px;width:16px;height:18px;opacity:.13;animation:asepdrift 9s ease-in-out infinite alternate}
  .asep-line{position:absolute;left:50%;bottom:20px;width:240px;height:2px;transform:translateX(-50%);background:linear-gradient(90deg,rgba(47,168,90,0),var(--accent),rgba(47,168,90,0))}
  .asep-body{position:relative;background:#f4f1e8;padding:20px clamp(18px,4vw,56px) 58px;overflow:hidden;max-width:var(--atl-content-max-width);margin:0 auto;box-sizing:border-box}
  .asep-heading{position:relative;z-index:2;text-align:center;margin:0 auto 26px;max-width:520px}
  .asep-eyebrow{font:700 11px Manrope,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}
  .asep-title{font:800 clamp(26px,3.4vw,36px) Archivo,sans-serif;color:#17251c;margin-top:8px}
  .asep-content{position:relative}
  .asep-logo{position:absolute;left:50%;top:calc(50% + 10px);transform:translate(-50%,-50%);width:min(372px,52vw);z-index:1}
  .asep-logo img{width:100%;display:block;animation:asepfloat 6s ease-in-out infinite}
  .asep-grid{position:relative;z-index:2;display:grid;grid-template-columns:1fr min(372px,40vw) 1fr;gap:22px;align-items:center}
  .asep-col{display:flex;flex-direction:column;gap:12px}
  .asep-card{position:relative;background:#fbfaf3;border:1px solid #e6e1d2;border-radius:11px;padding:14px 16px;overflow:hidden;box-shadow:0 8px 20px rgba(15,50,30,.06);transition:border-color .16s,transform .16s}
  .asep-card:hover{border-color:var(--accent);transform:translateY(-2px)}
  .asep-card .n{position:absolute;right:12px;top:6px;font:800 22px Archivo,sans-serif;color:var(--accent);opacity:.15}
  .asep-card .cat{font:700 10px Manrope,sans-serif;letter-spacing:.12em;color:#8a8471;text-transform:uppercase}
  .asep-card .nm{font:700 15.5px Archivo,sans-serif;color:#18251d;margin-top:6px;line-height:1.14}
  .asep-col--right .asep-card{text-align:right}
  .asep-col--right .asep-card .n{left:12px;right:auto}
  @keyframes asepfloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
  @keyframes asepdrift{0%{transform:translateX(0)}100%{transform:translateX(22px)}}
  @media(max-width:820px){
    .asep-logo{position:static;transform:none;width:170px;margin:4px auto 22px}
    .asep-grid{grid-template-columns:1fr 1fr;gap:12px}
    .asep-spacer{display:none}
    .asep-col--right .asep-card{text-align:left}
    .asep-col--right .asep-card .n{left:auto;right:12px}
  }
  @media(max-width:520px){.asep-grid{grid-template-columns:1fr}}
</style>
