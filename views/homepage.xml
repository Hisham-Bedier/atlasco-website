</section>

<!-- INDUSTRIES WE SERVE (pinned vertical→horizontal scroll - Hazem #5) -->
<div id="wrap_homepage_gap_3" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.homepage').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[4]"/>

<section class="atl-industries atl-industries-pinned" data-pinned-h-scroll="1">
  <div class="atl-industries-pinned-inner">
    <div class="atl-industries-header">
        <div>
            <div class="atl-section-label" data-fx="fade-up" t-field="content.home_industries_label"/>
            <h2 class="atl-section-title" style="margin-bottom:0;" data-fx="fade-up" data-fx-delay="80" t-field="content.home_industries_title"/>
        </div>
        <a t-att-href="content.home_industries_viewall_url or '/industries'" class="atl-view-all" t-field="content.home_industries_viewall"/>
    </div>
    <div class="atl-industries-scroller" data-industries-scroller="1">
        <button type="button" class="atl-ind-nav prev" aria-label="Previous industries">&#8592;</button>
        <div class="atl-industries-track">
            <t t-foreach="content.home_industry_ids" t-as="ind">
            <a t-att-href="ind.href" class="atl-industry-card atl-ind-snap" data-fx="fade-up" t-att-data-fx-delay="ind.fx_delay">
                <img t-attf-src="/web/image/atlasco.home.industry/#{ind.id}/image" t-att-alt="ind.image_alt" class="atl-industry-placeholder"/>
                <div class="atl-industry-card-overlay"></div>
                <div class="atl-industry-card-label">
                    <span class="tag">Industry</span>
                    <!-- ind.title is a plain Char field that intentionally stores a literal
                         "<br/>" for 2-line card titles (see atlasco.home.industry.title help
                         text, and the FOOD/POWER seed rows in data/seed_home.xml). t-out
                         escapes plain Python strings, so that "<br/>" was rendering as
                         visible "&lt;br/&gt;" text on the homepage instead of a line break
                         (ClickUp 869f03htx). ind.title is admin/CMS-controlled only (backend
                         + Website Editor), never public/portal user input, so rendering it
                         unescaped here is safe. -->
                    <h3 t-raw="ind.title"/>
                    <p class="ind-desc" t-field="ind.desc"/>
                    <div class="ind-line"></div>
                </div>
            </a>
            </t>
        </div>
        <button type="button" class="atl-ind-nav next" aria-label="Next industries">&#8594;</button>
    </div>
  </div>
</section>

<!-- PARTNERS — editorial dark-green honeycomb matrix v8 (design: Claude Design 2026-06-05) -->
<div id="wrap_homepage_gap_4" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.homepage').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[5]"/>

