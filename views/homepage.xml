<script>
(function(){
  var root=document.getElementById('atl-cine');
  if(!root||root.dataset.cineInit)return; root.dataset.cineInit='1';
  var reduce=window.matchMedia&amp;&amp;window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var reveals=[].slice.call(root.querySelectorAll('[data-reveal]'));
  function hide(el){
    var dl=parseFloat(el.getAttribute('data-delay'))||0;
    el.style.transitionProperty='opacity, transform';
    el.style.transitionTimingFunction='cubic-bezier(.16,.84,.34,1)';
    el.style.transitionDuration='0s'; el.style.transitionDelay=dl+'ms';
    el.style.willChange='opacity, transform'; el.style.opacity='0';
    el.style.transform='translate3d(0,42px,0)';
  }
  function show(el){ el.style.transitionDuration='0.9s'; el.style.opacity='1'; el.style.transform='none'; }
  if(reduce){reveals.forEach(function(el){el.style.opacity='1';el.style.transform='none';});}
  else{
    reveals.forEach(hide);
    function revTick(){var vh=window.innerHeight||800;reveals.forEach(function(el){if(!el.dataset.shown&amp;&amp;el.getBoundingClientRect().top&lt;vh*0.92){el.dataset.shown='1';show(el);}});}
    window.addEventListener('scroll',revTick,{passive:true});window.addEventListener('resize',revTick,{passive:true});setInterval(revTick,80);revTick();
    var pxEls=[].slice.call(root.querySelectorAll('[data-parallax]')); var raf=0;
    function onScroll(){ if(raf)return; raf=requestAnimationFrame(function(){ raf=0;
      var vh=window.innerHeight;
      pxEls.forEach(function(el){ var r=el.getBoundingClientRect(); var rel=(r.top+r.height/2-vh/2)/vh;
        var sp=parseFloat(el.getAttribute('data-speed'))||0.1;
        el.style.transform='translate3d(0,'+(-rel*sp*150).toFixed(1)+'px,0)'; }); }); }
    /* Odoo's website layout scrolls #wrapwrap, not window (html/body are
       overflow:hidden) — without this the parallax below never updated
       past its initial frame. */
    (document.getElementById('wrapwrap')||window).addEventListener('scroll',onScroll,{passive:true});
    window.addEventListener('resize',onScroll,{passive:true}); onScroll();
  }
})();
</script>

