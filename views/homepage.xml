<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" name="Homepage">
<t t-call="atlasco_website.atlasco_layout">

<!-- This page's OWN oe_structure (its arch literally contains it, unlike
     atlasco_layout's shared #wrap which every page nests inside) — matches
     the fix already applied on /culture (views/atlasco_culture_page.xml)
     and /services, for ticket 869f082az ("cannot add a new section BETWEEN
     existing customized sections"). Without a page-owned oe_structure, the
     Website Editor has no valid drop target to save a new mid-page section
     into on THIS page specifically — the only oe_structure in scope was
     the one shared by every page (the layout's #wrap), so Odoo refused the
     drop rather than let a homepage edit silently write into every page's
     shared chrome. Wrapping the homepage's own top-level sections below in
     <div id="wrap" class="oe_structure"> gives / its own independent,
     page-scoped drop target, so "Insert Blocks" can now drop a new
     snippet between any two of the sections below (hero, stats, solutions
     tabs, industries, partners, separator, careers/primegear cinematic
     block). -->
<div id="wrap_homepage" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.homepage').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]">

<!-- Genuinely-empty "gap" oe_structure divs threaded between the sections
     below are real Odoo-native Insert-Blocks drop targets - see the long
     root-cause comment on wrap_about in atlasco_about_page.xml. -->
<div id="wrap_homepage_gap_0" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.homepage').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[1]"/>

<!-- HERO -->
<!-- Model-backed (atlasco.home.slide) carousel with any number of slides;
     falls back to the original single static hero if no slides exist. -->
<t t-if="home_slides">
<section class="atl-hero atl-hero--carousel" data-carousel="hero">
    <div class="atl-hero-track">
        <t t-foreach="home_slides" t-as="s">
        <div t-attf-class="atl-hero-slide#{' is-active' if s_index == 0 else ''}" t-att-data-index="s_index" t-att-data-slide-id="s.id">
            <span class="atl-hero-slide-media"
                  t-field="s.image"
                  t-options='{"widget": "image", "max_width": 1920, "max_height": 1080, "alt-field": "image_alt", "qweb_img_responsive": false}'/>
            <t t-set="has_text" t-value="s.established or s.line1 or s.highlight or s.subtitle or s.btn_label"/>
            <t t-if="s.show_overlay or has_text or editable">
                <div t-if="s.show_overlay or has_text" t-attf-class="atl-hero-scrim atl-hero-scrim--#{s.text_theme}"/>
                <div class="atl-hero-align">
                <div t-attf-class="atl-hero-content atl-hero-content--#{s.text_theme}">
                    <div t-if="s.established or editable" class="atl-hero-established" t-field="s.established"/>
                    <h1 t-if="s.line1 or s.highlight or editable" class="atl-hero-title">
                        <span t-if="s.line1 or editable" class="atl-hero-line1" t-field="s.line1"/>
                        <span t-if="s.highlight or editable" class="highlight" t-field="s.highlight"/>
                    </h1>
                    <p t-if="s.subtitle or editable" class="atl-hero-subtitle" t-field="s.subtitle"/>
                    <a t-if="s.btn_label or editable" t-att-href="s.btn_url or '/about'" class="btn-hero" t-field="s.btn_label"/>
                </div>
                </div>
            </t>
        </div>
        </t>
    </div>
    <t t-if="len(home_slides) &gt; 1">
        <button type="button" class="atl-hero-nav atl-hero-nav--prev" aria-label="Previous slide"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
        <button type="button" class="atl-hero-nav atl-hero-nav--next" aria-label="Next slide"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
        <div class="atl-hero-dots">
            <t t-foreach="home_slides" t-as="s">
                <button type="button" class="atl-hero-dot" t-att-data-index="s_index"
                        t-attf-aria-label="Go to slide #{s_index + 1}"/>
            </t>
        </div>
    </t>
</section>
</t>
<t t-else="">
<section class="atl-hero" data-parallax="hero">
    <t t-set="hero_bg" t-value="request.env['atlasco.page.hero'].sudo()._image_url('home')"/>
    <div class="atl-hero-bg" t-attf-style="#{'background-image:url(%s);background-size:cover;background-position:center;' % hero_bg if hero_bg else ''}"></div>
    <div class="atl-hero-overlay"></div>
    <div class="atl-hero-align">
    <div class="atl-hero-content">
        <div class="atl-hero-established" data-fx="fade-up" t-field="content.home_hero_established"/>
        <h1 class="atl-hero-title" data-fx="fade-up" data-fx-delay="80">
            <span class="atl-hero-line1" t-field="content.home_hero_line1"/>
            <span class="highlight" t-field="content.home_hero_highlight"/>
        </h1>
        <p class="atl-hero-subtitle" data-fx="fade-up" data-fx-delay="160" t-field="content.home_hero_subtitle"/>
        <a href="/about" class="btn-hero" data-fx="fade-up" data-fx-delay="240" t-field="content.home_hero_btn"/>
    </div>
    </div>
</section>
</t>

<div id="wrap_homepage_gap_1" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.homepage').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[2]"/>

<!-- STATS -->
<div class="atl-stats">
  <div class="atl-stats-inner">
    <t t-foreach="content.home_stat_ids" t-as="s">
    <div class="atl-stat-item">
        <div class="atl-stat-number" t-att-data-target="s.target" t-att-data-suffix="s.suffix">0</div>
        <div class="atl-stat-label" t-field="s.label"/>
    </div>
    </t>
  </div>
</div>

<div id="wrap_homepage_gap_2" class="oe_structure" data-oe-model="ir.ui.view" t-att-data-oe-id="request.env.ref('atlasco_website.homepage').id" data-oe-field="arch" data-oe-xpath="/t[1]/t[1]/div[1]/div[3]"/>

<!-- SOLUTIONS TABS -->
<section class="atl-solutions" data-scrollx="categories">
    <div class="atl-solutions-label" data-fx="fade-up" t-field="content.home_solutions_label"/>
    <h2 class="atl-solutions-title" data-fx="fade-up" data-fx-delay="80" t-field="content.home_solutions_title"/>
    <div class="atl-solutions-inner" data-fx="fade-up" data-fx-delay="160">
