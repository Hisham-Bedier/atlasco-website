            </div>
            <div class="atl-tab-image">
                <img src="/atlasco_website/static/src/img/solutions/gas-generation-system.jpg" alt="Gas Generation Systems"/>
            </div>
        </div>

        <div class="atl-tab-content" data-tab-content="oil-lubrication">
            <div class="atl-tab-text">
                <h3 t-field="content.home_sol_oil_title"/>
                <p class="atl-tab-sub" t-field="content.home_sol_oil_sub"/>
                <p t-field="content.home_sol_oil_body"/>
                <ul class="atl-tab-checks">
                    <t t-foreach="content.home_solution_check_ids.filtered(lambda c: c.tab == 'oil')" t-as="chk">
                    <li><span t-field="chk.text"/></li>
                    </t>
                </ul>
                <a href="/products/lubrication-oil" class="atl-tab-link" t-field="content.home_sol_oil_link"/>
            </div>
            <div class="atl-tab-image">
