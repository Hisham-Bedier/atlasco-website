</div>

<script>
(function(){
  // Was root.querySelectorAll() scoped to a single wrapping ".lax" div; now
  // that each section carries its own "lax" class directly (so the Website
  // Editor can add new sections between them - see "enable Add Section"
  // ticket), query the whole document instead so every section's
  // [data-reveal] elements are still found.
  var els = [].slice.call(document.querySelectorAll('[data-reveal]'));
  var reduce = window.matchMedia &amp;&amp; window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  els.forEach(function(el){ el.style.transition='opacity .7s cubic-bezier(.22,.61,.36,1), transform .7s cubic-bezier(.22,.61,.36,1)'; el.style.transform='translateY(26px)'; });
  function show(el){ el.style.opacity='1'; el.style.transform='none'; el.setAttribute('data-shown','1'); }
  if (reduce){ els.forEach(show); }
  else {
    var tick=function(){ var vh=window.innerHeight||document.documentElement.clientHeight;
      for (var i=0;i&lt;els.length;i++){ var el=els[i]; if(el.getAttribute('data-shown')) continue; var r=el.getBoundingClientRect(); if(r.top&lt;vh*0.92 &amp;&amp; r.bottom&gt;0) show(el); } };
    /* Odoo's website layout scrolls #wrapwrap, not window (html/body are
       overflow:hidden) — a plain window scroll listener never fires on a
       real page, so anything below the initial fold stayed permanently
       hidden. */
    (document.getElementById('wrapwrap')||window).addEventListener('scroll',tick,{passive:true}); window.addEventListener('resize',tick,{passive:true});
    var revealInterval=setInterval(function(){ tick(); if(!els.some(function(el){return !el.getAttribute('data-shown');})) clearInterval(revealInterval); },150);
    [0,90,260,600].forEach(function(t){ setTimeout(tick,t); });
  }
  // BUG-09 (869f03uhk): local-video tiles — click-to-toggle play/pause so
  // each behaves like a styled thumbnail (poster + play button) rather
  // than exposing the browser's native video-controls chrome at rest.
  // querySelectorAll, not querySelector: the gallery is now a backend
  // collection (atlasco.culture.life) an admin can add more video-type
  // tiles to, not a single hardcoded one.
  document.querySelectorAll('.lax-tile-video').forEach(function(vidTile){
    var vid = vidTile.querySelector('video');
    if (!vid) return;
    // Paint a real first-frame "poster" (see the &lt;video&gt; comment
    // above — there's no valid poster attribute) as soon as enough of the
    // video has loaded to seek. Just setting currentTime on a video
    // that's never played is not enough to force a repaint in every
    // browser — a real play()+pause() round-trip is the standard,
    // reliable fix (confirmed: seeking alone left the canvas blank even
    // though currentTime/readyState updated correctly).
    var seekPoster = function(){
      try {
        vid.currentTime = 0.1;
        var p = vid.play();
        if (p &amp;&amp; p.then) { p.then(function(){ vid.pause(); }).catch(function(){}); }
        else { vid.pause(); }
      } catch (e) {}
    };
    if (vid.readyState >= 1) seekPoster();
    else vid.addEventListener('loadedmetadata', seekPoster);
    vidTile.addEventListener('click', function(){
      if (vid.paused){ vid.play(); } else { vid.pause(); }
    });
    vid.addEventListener('play', function(){ vidTile.classList.add('lax-playing'); });
    vid.addEventListener('pause', function(){ vidTile.classList.remove('lax-playing'); });
    vid.addEventListener('ended', function(){ vidTile.classList.remove('lax-playing'); });
  });
})();
</script>

