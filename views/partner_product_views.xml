<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlasco_partner_product_list" model="ir.ui.view">
        <field name="name">atlasco.partner.product.list</field>
        <field name="model">atlasco.partner.product</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="partner_slug"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="image" widget="image" options="{'size': [64, 64]}"/>
                <field name="url"/>
                <field name="external_url"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_atlasco_partner_product_form" model="ir.ui.view">
        <field name="name">atlasco.partner.product.form</field>
        <field name="model">atlasco.partner.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="partner_slug"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="name"/>
                        <field name="url"/>
                        <field name="external_url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_atlasco_partner_product" model="ir.actions.act_window">
        <field name="name">Partner Product Range</field>
        <field name="res_model">atlasco.partner.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a product</p>
            <p>Each product shows in the "Product Range" section on its partner subpage (/partners/&lt;slug&gt;). Group or filter by Partner to find a specific page's list.</p>
        </field>
    </record>

    <record id="view_atlasco_partner_product_search" model="ir.ui.view">
        <field name="name">atlasco.partner.product.search</field>
        <field name="model">atlasco.partner.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_slug"/>
                <field name="name"/>
                <group expand="1" string="Group By">
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'partner_slug'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_atlasco_partner_product"
              name="Partner Product Range"
              parent="atlasco_website.menu_atlasco_group_catalog"
              action="action_atlasco_partner_product"
              sequence="50"/>

    <!-- Idempotent seed from the controller's former hardcoded data (runs on install + upgrade) -->
    <function model="atlasco.partner.product" name="_seed_from_controller"/>

    <!-- ClickUp 869emevtx: idempotently backfill `image` from whatever's
         currently rendering on the live page (runs on install + upgrade;
         never overwrites a row that already has a real image). -->
    <function model="atlasco.partner.product" name="_backfill_images_from_catalog"/>
</odoo>
