        <field name="content_id" ref="content_singleton"/>
        <field name="sequence">10</field>
        <field name="title">Real Impact on Egyptian Industry</field>
        <field name="body">Your work directly supports the infrastructure and production lines that power Egypt's leading industrial sectors.</field>
    </record>
