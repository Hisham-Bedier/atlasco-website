    <record id="seed_career_opening_1" model="atlasco.career.opening">
        <field name="content_id" ref="content_singleton"/>
        <field name="sequence">10</field>
        <field name="title">Senior Service Engineer</field>
        <field name="department">Service</field>
        <field name="location">Cairo</field>
        <field name="job_type">Full-time</field>
        <field name="blurb">Technical lead for on-site installation, maintenance, and complex troubleshooting of industrial systems.</field>
        <field name="description">As a Senior Service Engineer, you will be the technical lead for on-site installation, maintenance, and complex troubleshooting of industrial systems</field>
        <field name="points">Lead installation &amp; commissioning of industrial systems
Diagnose and resolve complex technical issues on-site
Mentor junior service engineers
Own customer relationships through reliable support</field>
    </record>
    <record id="seed_career_opening_2" model="atlasco.career.opening">
        <field name="content_id" ref="content_singleton"/>
        <field name="sequence">20</field>
        <field name="title">Sales Manager – Air Systems</field>
        <field name="department">Sales</field>
        <field name="location">Alexandria</field>
        <field name="job_type">Full-time</field>
        <field name="blurb">Drive the strategic growth of our industrial air solutions — HVAC, compressed air, and pneumatic systems.</field>
        <field name="description">As the Sales Manager for Air Systems, you will lead the strategic growth of our industrial air solutions (HVAC, compressed air, or pneumatic systems)</field>
        <field name="points">Grow the air-systems portfolio across the region
Build long-term relationships with industrial clients
Translate technical needs into reliable solutions
Consistently hit and exceed revenue targets</field>
    </record>
    <record id="seed_career_opening_3" model="atlasco.career.opening">
        <field name="content_id" ref="content_singleton"/>
        <field name="sequence">30</field>
        <field name="title">Logistics Coordinator</field>
        <field name="department">Logistics</field>
        <field name="location">Suez</field>
        <field name="job_type">Full-time</field>
        <field name="blurb">The backbone of the supply chain — the seamless movement of goods from our Suez facility to destinations worldwide.</field>
        <field name="description">You will be the backbone of the supply chain, ensuring the seamless movement of goods from our Suez facility to regional and international destinations</field>
        <field name="points">Coordinate shipments, documentation &amp; customs
Optimize routes and delivery timelines
Liaise with suppliers and internal teams
Keep the flow moving, on time, every time</field>
    </record>
    <record id="seed_career_opening_4" model="atlasco.career.opening">
        <field name="content_id" ref="content_singleton"/>
        <field name="sequence">40</field>
        <field name="title">Mechanical Design Engineer</field>
        <field name="department">Engineering</field>
        <field name="location">Cairo</field>
        <field name="job_type">Full-time</field>
        <field name="blurb">Design and refine the mechanical systems that power Egypt's leading industrial facilities.</field>
        <field name="points">Develop mechanical designs &amp; technical drawings
Run analysis, tolerancing &amp; validation
Collaborate closely with service and sales teams
Take ideas from concept to commissioning</field>
    </record>
